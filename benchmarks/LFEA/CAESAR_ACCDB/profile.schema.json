{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "caesar-accdb-benchmark-profile/v1",
  "title": "CAESAR ACCDB benchmark profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profileId",
    "benchmarkId",
    "installationTemperature",
    "caseSelection",
    "nodeSelection",
    "resultFamilies",
    "conventions",
    "equilibriumTolerance",
    "tolerances",
    "configurationAuthority"
  ],
  "properties": {
    "schema": { "const": "caesar-accdb-benchmark-profile/v1" },
    "profileId": { "type": "string", "minLength": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "installationTemperature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["C", "F", "K"] }
      }
    },
    "caseSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "cases"],
          "properties": {
            "mode": { "const": "ALL_AVAILABLE" },
            "cases": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "cases"],
          "properties": {
            "mode": { "const": "EXPLICIT" },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["caseId", "lcaseNumber"],
                "properties": {
                  "caseId": { "type": "string", "minLength": 1 },
                  "lcaseNumber": { "type": "integer" }
                }
              }
            }
          }
        }
      ]
    },
    "nodeSelection": {
      "enum": ["ALL_OUTPUT_NODES", "INPUT_ENDPOINT_NODES"]
    },
    "resultFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DISPLACEMENT",
          "RESTRAINT_REACTION",
          "GLOBAL_ELEMENT_END_ACTION",
          "NODAL_EQUILIBRIUM"
        ]
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restraintReaction"],
      "properties": {
        "restraintReaction": {
          "enum": ["CAESAR_FORCE_ON_SUPPORT", "FORCE_ON_STRUCTURE"]
        }
      }
    },
    "equilibriumTolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forceN", "momentNm"],
      "properties": {
        "forceN": { "type": "number", "minimum": 0 },
        "momentNm": { "type": "number", "minimum": 0 }
      }
    },
    "tolerances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["absolute", "relative", "scaleFloor"],
        "properties": {
          "absolute": { "type": "number", "minimum": 0 },
          "relative": { "type": "number", "minimum": 0 },
          "scaleFloor": { "type": "number", "minimum": 0 },
          "comparisonMode": {
            "enum": [
              "COMBINED_ABSOLUTE_RELATIVE_SCALE_FLOOR",
              "LITERAL_RELATIVE_WITH_ZERO_ABSOLUTE"
            ]
          },
          "zeroReferenceAbsolute": { "type": "number", "minimum": 0 }
        }
      }
    },
    "configurationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "caesarVersion", "precedence", "layers", "unresolvedSettings"],
      "properties": {
        "schema": { "const": "caesar-configuration-authority/v1" },
        "caesarVersion": { "type": "string", "minLength": 1 },
        "precedence": {
          "const": [
            "OVERALL_GLOBAL_DEFAULT",
            "INDIVIDUAL_FILE_SETTING",
            "LOAD_CASE_SETTING",
            "MODEL_INPUT"
          ]
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overallGlobalDefault", "modelInput", "individualFile", "loadCase"],
          "properties": {
            "overallGlobalDefault": { "$ref": "#/$defs/configurationLayer" },
            "modelInput": { "$ref": "#/$defs/configurationLayer" },
            "individualFile": { "$ref": "#/$defs/configurationLayer" },
            "loadCase": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "cases"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "cases": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/configurationSettings" }
                }
              }
            }
          }
        },
        "unresolvedSettings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["setting", "caseId", "reason"],
            "properties": {
              "setting": { "type": "string", "minLength": 1 },
              "caseId": { "type": ["string", "null"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "linearSolve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thermalExpansion",
        "gravityAcceleration",
        "bourdonPressureEffects",
        "directionalB31JTeeFlexibility",
        "teeNominalDiameterRelativeTolerance",
        "reducerCondensation",
        "b31jSmooth90FlexibilityCorrection",
        "bendPressureStiffening",
        "restraintRepresentation",
        "bendAxialShape"
      ],
      "properties": {
        "thermalExpansion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coefficientPerKelvin", "authorityStatus", "source"],
          "properties": {
            "coefficientPerKelvin": { "type": "number", "exclusiveMinimum": 0 },
            "authorityStatus": { "enum": ["RESOLVED", "PROVISIONAL"] },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "gravityAcceleration": { "type": "number", "exclusiveMinimum": 0 },
        "bourdonPressureEffects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source"],
          "properties": {
            "mode": {
              "enum": ["DISABLED", "TRANSLATION_ONLY", "TRANSLATION_AND_ROTATION"]
            },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "directionalB31JTeeFlexibility": { "type": "boolean" },
        "teeNominalDiameterRelativeTolerance": { "type": "number", "minimum": 0, "maximum": 0.01 },
        "reducerCondensation": { "type": "boolean" },
        "b31jSmooth90FlexibilityCorrection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "authorityStatus", "source"],
          "properties": {
            "enabled": { "type": "boolean" },
            "authorityStatus": { "enum": ["RESOLVED", "UNRESOLVED"] },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "bendPressureStiffening": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pressureSource", "authorityStatus", "source"],
          "properties": {
            "pressureSource": { "type": "string", "minLength": 1 },
            "authorityStatus": { "enum": ["RESOLVED", "PROVISIONAL"] },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "restraintRepresentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authorityStatus", "source"],
          "properties": {
            "mode": { "type": "string", "minLength": 1 },
            "authorityStatus": { "enum": ["RESOLVED", "PROVISIONAL"] },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "bendAxialShape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "method", "source"],
          "properties": {
            "enabled": { "type": "boolean" },
            "method": { "const": "DISCRETIZED_CURVED_CENTRELINE_AXIAL_DOF_V1" },
            "source": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "configurationLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "settings"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "settings": { "$ref": "#/$defs/configurationSettings" }
      }
    },
    "configurationSettings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/configurationValue" }
    },
    "configurationValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
