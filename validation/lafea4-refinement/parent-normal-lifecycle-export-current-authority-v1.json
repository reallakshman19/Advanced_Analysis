  "stage": "LAFEA.4",
  "purpose": "PREVENT_RETAINED_LIFECYCLE_EVIDENCE_FROM_BEING_MISTAKEN_FOR_CURRENT_ENGINEERING_AUTHORITY_AFTER_GATE_REVOCATION",
  "currentTrustRoot": "NULL",
