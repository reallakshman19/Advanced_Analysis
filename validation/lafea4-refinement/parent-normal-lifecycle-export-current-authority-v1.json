    "liveCalculationState": "CALCULATION_NOT_RUN",
    "liveResultReady": true,
    "expectedCurrentResultAccepted": true,
    "expectedResultAuthorityBasis": "LEGACY_LIFECYCLE_READINESS"
  },
  "forbidden": [
    "rewriting retained lifecycle artifact history on authority revocation",
    "treating lifecycle EXECUTION CURRENT/PASS as sufficient for governed current result authority",
    "revoking legacy non-governed lifecycle-result readiness solely because local stage.execution is absent",
    "treating a retained release record as sufficient for current release authority",
    "letting an export object itself grant engineering or release authority",
    "activating the parent-normal production trust root in TECH-12K",
