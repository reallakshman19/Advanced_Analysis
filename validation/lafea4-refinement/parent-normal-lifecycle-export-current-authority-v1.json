    "readiness.releaseState == RELEASE_QUALIFIED",
    "readiness.releaseBinding.releaseQualified == true"
  ],
  "requiredInterpretationFlags": {
    "lifecycleArtifactStatusIsRetainedEvidenceOnly": true,
    "retainedExecutionQualificationGrantsCurrentAuthority": false,
    "retainedReleaseRecordGrantsCurrentAuthority": false,
    "exportGrantsCurrentResultAuthority": false,
    "exportGrantsCurrentReleaseAuthority": false
  },
  "mandatoryNegativeCase": {
    "retainedExecutionStatus": "QUALIFIED",
    "retainedLifecycleExecutionArtifactStatus": "CURRENT",
    "retainedLifecycleExecutionArtifactQualification": "PASS",
    "liveCalculationState": "CALCULATION_NOT_ACCEPTED_BY_STAGE_CONTRACT",
    "liveResultReady": false,
    "expectedCurrentResultAccepted": false,
    "expectedBlockingReason": "LAFEA4_PARENT_NORMAL_PRODUCTION_GATE_BLOCKED"
  },
  "mandatoryLegacyCompatibilityCase": {
    "stage": "LAFEA.3",
    "governedRoute": false,
    "localExecutionPresent": false,
